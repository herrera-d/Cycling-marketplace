# Copia este archivo a `.env.local` (desarrollo) y configúralas también en Vercel.
# Nunca commitees los `.env*.local`.
#
# ── Ambientes de base de datos ───────────────────────────────────────────────
# Los scripts de BD (drizzle-kit, seed) eligen la base con APP_ENV:
#   APP_ENV=development (default) → lee .env.development.local → .env.local → .env
#   APP_ENV=staging               → lee .env.staging.local     → .env.local → .env
#   APP_ENV=production            → NO lee archivos; solo variables del entorno
#
# Archivos por ambiente (todos ignorados por git):
#   .env.local              → secretos compartidos (OAuth, Supabase) + DATABASE_URL de dev
#   .env.development.local  → (opcional) DATABASE_URL del branch de dev
#   .env.staging.local      → DATABASE_URL del branch de staging
#   Producción              → variables configuradas en Vercel (scope Production)
#
# La app (Next) usa NODE_ENV para esto, no APP_ENV: `next dev` lee .env.local.
# En Vercel, los scopes Development/Preview/Production ya separan los valores.

# ── Base de datos (Neon) — Fase 1 ────────────────────────────────────────────
# Cadena de conexión de Neon. Usa la URL *pooled* (con "-pooler") para la app.
#   postgresql://USUARIO:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Google OAuth (Auth.js) — Fase 2 ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=
# URL base de la app (en producción, el dominio final).
AUTH_URL=http://localhost:3000
# Origen público del sitio (sitemap, robots, metadataBase/OG). Por ambiente:
#   development → http://localhost:3000      production → https://<dominio-final>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase Storage (imágenes) — Fase 5 ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# ¡Solo servidor! Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket por ambiente (aislamiento de imágenes):
#   development → listings        staging → listings-staging   production → listings-prod
NEXT_PUBLIC_SUPABASE_BUCKET=listings

# ── Rate limiting (Fase 8) ───────────────────────────────────────────────────
# No requiere variables: los contadores viven en la misma tabla `rate_limits`
# de Neon, así valen en local, staging y en todas las instancias de Vercel.
