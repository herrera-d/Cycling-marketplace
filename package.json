    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
